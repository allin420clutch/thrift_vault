# ThriftVault Environment Variables
# Copy this file to .env.local and fill in your real values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini AI
VITE_GEMINI_API_KEY=your_gemini_api_key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Amazon Associates
VITE_AMAZON_ASSOCIATES_TAG=yourstore-20
VITE_AMAZON_ACCESS_KEY=your_amazon_access_key
VITE_AMAZON_SECRET_KEY=your_amazon_secret_key

# Etsy API
VITE_ETSY_API_KEY=your_etsy_api_key

# Pinterest API
VITE_PINTEREST_APP_ID=your_pinterest_app_id

# Shopify Storefront API
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_access_token
